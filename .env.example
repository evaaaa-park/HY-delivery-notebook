# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
# .env.local is gitignored. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hy-delivery-notebook.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hy-delivery-notebook
VITE_FIREBASE_STORAGE_BUCKET=hy-delivery-notebook.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region of the Cloud Functions (same as Firestore: Seoul)
VITE_FUNCTIONS_REGION=asia-northeast3
