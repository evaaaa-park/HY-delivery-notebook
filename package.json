{
  "name": "hy-delivery-notebook",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "헬리오 배달수첩: route, ordering and customer notebook for an hy delivery manager. Offline-first PWA on Firebase.",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "images": "node scripts/build-images.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
